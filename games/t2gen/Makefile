include $(APPDIR)/Make.defs
PROGNAME = $(CONFIG_GAMES_T2GEN_PROGNAME)
PRIORITY = $(CONFIG_GAMES_T2GEN_PRIORITY)
STACKSIZE = $(CONFIG_GAMES_T2GEN_STACKSIZE)
MODULE = $(CONFIG_GAMES_T2GEN)
MAINSRC = src/t2gen_main.c
ifeq ($(CONFIG_GAMES_T2GEN_MUSASHI),y)
CSRCS = src/t2gen_musashi.c src/t2gen_vdp.c src/t2gen_render.c src/musashi/m68kcpu.c src/musashi/m68kops.c
CFLAGS += -I$(APPDIR)/games/t2gen/src/musashi
ifneq ($(filter y,$(CONFIG_GAMES_T2GEN_V010_NATIVE_CMP_EXEC) $(CONFIG_GAMES_T2GEN_V011_NATIVE_SYNC_EXEC)),)
CFLAGS += -DT2GEN_V010_NATIVE_CMP_EXEC=1
endif
ifeq ($(CONFIG_GAMES_T2GEN_V011_NATIVE_SYNC_EXEC),y)
CFLAGS += -DT2GEN_V011_NATIVE_SYNC_EXEC=1
endif
ifeq ($(CONFIG_GAMES_T2GEN_V012_NATIVE_BRANCH_EXEC),y)
CFLAGS += -DT2GEN_V012_NATIVE_BRANCH_EXEC=1
endif
ifeq ($(CONFIG_GAMES_T2GEN_V016_SWITCH_DISPATCH),y)
CFLAGS += -DT2GEN_V016_SWITCH_DISPATCH=1
endif
ifeq ($(CONFIG_GAMES_T2GEN_V018_ROUTINE_DISPATCH),y)
CFLAGS += -DT2GEN_V018_ROUTINE_DISPATCH=1
endif
ifeq ($(CONFIG_GAMES_T2GEN_V017_NATIVE_SYNC_RTS),y)
CFLAGS += -DT2GEN_V017_NATIVE_SYNC_RTS=1
endif
ifeq ($(CONFIG_GAMES_T2GEN_V015_PAIRED_SYNC),y)
CFLAGS += -DT2GEN_V015_PAIRED_SYNC=1
endif
ifneq ($(filter y,$(CONFIG_GAMES_T2GEN_V05_TARGET_TRACE) $(CONFIG_GAMES_T2GEN_V06_FLOW_TRACE) $(CONFIG_GAMES_T2GEN_V07_EPISODES)),)
CFLAGS += -DM68K_INSTRUCTION_HOOK=1
endif
else
CSRCS = src/t2gen_boot.c
endif

ifeq ($(CONFIG_GAMES_T2GEN_V019_PREDECODED_SYNC),y)
CFLAGS += -DT2GEN_V019_PREDECODED_SYNC=1
endif

ifeq ($(CONFIG_GAMES_T2GEN_V020_DIRECT_BRANCH),y)
CFLAGS += -DT2GEN_V020_DIRECT_BRANCH=1
endif

ifeq ($(CONFIG_GAMES_T2GEN_V021_OPCODE_PROFILE),y)
CFLAGS += -DT2GEN_V021_OPCODE_PROFILE=1
endif

ifeq ($(CONFIG_GAMES_T2GEN_V022_PC_PROFILE),y)
CFLAGS += -DT2GEN_V022_PC_PROFILE=1
endif

ifeq ($(CONFIG_GAMES_T2GEN_V023_NATIVE_5670),y)
CFLAGS += -DT2GEN_V023_NATIVE_5670=1
endif

ifeq ($(CONFIG_GAMES_T2GEN_V024_NATIVE_DBF),y)
CFLAGS += -DT2GEN_V024_NATIVE_DBF=1
endif

ifeq ($(CONFIG_GAMES_T2GEN_V025_NATIVE_MOVEQ),y)
CFLAGS += -DT2GEN_V025_NATIVE_MOVEQ=1
endif

include $(APPDIR)/Application.mk
